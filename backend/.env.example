# ─────────────────────────────────────────────
# ExamLens — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env to Git.
# ─────────────────────────────────────────────

# Path to the Tesseract OCR executable on Windows.
# Default install location — adjust if yours is different.
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Path to the SQLite database file used for local development.
# Member 6 will replace this with the shared DB connection string.
DATABASE_URL=sqlite:///./examlens_dev.db

# Set to "development" for verbose logging, "production" to reduce noise.
ENV=development
